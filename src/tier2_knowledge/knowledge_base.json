{
  "meta": {
    "version": "0.2.0",
    "description": "Cơ sở tri thức y khoa dạng luật (trích từ hướng dẫn lâm sàng). Chỉ dùng cho HỖ TRỢ QUYẾT ĐỊNH.",
    "sources": [
      "ESC/ESH 2018",
      "ADA 2023",
      "KDIGO 2022",
      "WHO TRS 894",
      "WHO SpO2 2019",
      "ACC/AHA 2023"
    ]
  },
  "metrics": {
    "systolic_bp": {
      "name": "Huyết áp tâm thu",
      "unit": "mmHg",
      "range": [
        90,
        140
      ]
    },
    "diastolic_bp": {
      "name": "Huyết áp tâm trương",
      "unit": "mmHg",
      "range": [
        60,
        90
      ]
    },
    "heart_rate": {
      "name": "Nhịp tim",
      "unit": "lần/phút",
      "range": [
        60,
        100
      ]
    },
    "glucose": {
      "name": "Đường huyết (ngẫu nhiên)",
      "unit": "mmol/L",
      "range": [
        3.9,
        7.0
      ]
    },
    "glucose_fasting": {
      "name": "Đường huyết lúc đói",
      "unit": "mmol/L",
      "range": [
        4.4,
        6.1
      ]
    },
    "hba1c": {
      "name": "HbA1c",
      "unit": "%",
      "range": [
        4.0,
        6.5
      ]
    },
    "creatinine": {
      "name": "Creatinine",
      "unit": "mg/dL",
      "range": [
        0.6,
        1.3
      ]
    },
    "egfr": {
      "name": "eGFR",
      "unit": "ml/phút/1.73m²",
      "range": [
        60,
        150
      ]
    },
    "spo2": {
      "name": "SpO2",
      "unit": "%",
      "range": [
        95,
        100
      ]
    },
    "bmi": {
      "name": "BMI",
      "unit": "kg/m²",
      "range": [
        18.5,
        25
      ]
    }
  },
  "rules": [
    {
      "rule_id": "R_CV_01",
      "name": "Tăng huyết áp",
      "system": "tim_manh",
      "condition": {
        "logic": "and",
        "conditions": [
          {
            "metric": "systolic_bp",
            "op": ">",
            "threshold": 140
          },
          {
            "metric": "diastolic_bp",
            "op": ">",
            "threshold": 90
          }
        ]
      },
      "severity": 0.8,
      "specialty": "Khoa Tim mạch",
      "evidence": "ESC/ESH 2018",
      "source_url": "https://www.eshonline.org/esh-content/uploads/2018/10/Download.pdf"
    },
    {
      "rule_id": "R_CV_02",
      "name": "Nhịp tim nhanh kéo dài",
      "system": "tim_manh",
      "condition": {
        "logic": "and",
        "conditions": [
          {
            "metric": "heart_rate",
            "op": ">",
            "threshold": 100,
            "window_days": 7
          }
        ]
      },
      "severity": 0.6,
      "specialty": "Khoa Tim mạch",
      "evidence": "Hướng dẫn nhịp tim 2023",
      "source_url": "https://doi.org/10.1161/CIR.0000000000001193"
    },
    {
      "rule_id": "R_CV_03",
      "name": "Tăng huyết áp tâm thu đơn độc",
      "system": "tim_manh",
      "condition": {
        "logic": "or",
        "conditions": [
          {
            "metric": "systolic_bp",
            "op": ">",
            "threshold": 140
          }
        ]
      },
      "severity": 0.7,
      "specialty": "Khoa Tim mạch",
      "evidence": "ESC/ESH 2018",
      "source_url": "https://www.eshonline.org/esh-content/uploads/2018/10/Download.pdf"
    },
    {
      "rule_id": "R_END_01",
      "name": "Tăng đường huyết lúc đói",
      "system": "noi_tiet",
      "condition": {
        "logic": "or",
        "conditions": [
          {
            "metric": "glucose_fasting",
            "op": ">",
            "threshold": 7.0
          },
          {
            "metric": "glucose",
            "op": ">",
            "threshold": 7.0
          }
        ]
      },
      "severity": 0.7,
      "specialty": "Khoa Nội tiết",
      "evidence": "ADA 2023",
      "source_url": "https://diabetesjournals.org/care/issue/46/Supplement_1"
    },
    {
      "rule_id": "R_END_02",
      "name": "HbA1c vượt ngưỡng tiểu đường",
      "system": "noi_tiet",
      "condition": {
        "logic": "or",
        "conditions": [
          {
            "metric": "hba1c",
            "op": ">",
            "threshold": 6.5
          }
        ]
      },
      "severity": 0.8,
      "specialty": "Khoa Nội tiết",
      "evidence": "ADA 2023",
      "source_url": "https://diabetesjournals.org/care/issue/46/Supplement_1"
    },
    {
      "rule_id": "R_KID_01",
      "name": "Creatinine tăng - nghi ngờ suy thận",
      "system": "than",
      "condition": {
        "logic": "or",
        "conditions": [
          {
            "metric": "creatinine",
            "op": ">",
            "threshold": 1.3,
            "unit": "mg/dL"
          }
        ]
      },
      "severity": 0.7,
      "specialty": "Khoa Thận",
      "evidence": "KDIGO 2022",
      "source_url": "https://kdigo.org/wp-content/uploads/2022/10/KDIGO-2022-Clinical-Practice-Guideline-for-Diabetes-Management-in-CKD.pdf"
    },
    {
      "rule_id": "R_KID_02",
      "name": "eGFR giảm",
      "system": "than",
      "condition": {
        "logic": "or",
        "conditions": [
          {
            "metric": "egfr",
            "op": "<",
            "threshold": 60
          }
        ]
      },
      "severity": 0.8,
      "specialty": "Khoa Thận",
      "evidence": "KDIGO 2022",
      "source_url": "https://kdigo.org/wp-content/uploads/2022/10/KDIGO-2022-Clinical-Practice-Guideline-for-Diabetes-Management-in-CKD.pdf"
    },
    {
      "rule_id": "R_RES_01",
      "name": "Giảm bão hòa oxy",
      "system": "ho_hap",
      "condition": {
        "logic": "or",
        "conditions": [
          {
            "metric": "spo2",
            "op": "<",
            "threshold": 94
          }
        ]
      },
      "severity": 0.9,
      "specialty": "Khoa Hô hấp",
      "evidence": "WHO — Hướng dẫn sử dụng SpO2",
      "source_url": "https://iris.who.int/handle/10665/345392"
    },
    {
      "rule_id": "R_MET_01",
      "name": "BMI vượt ngưỡng thừa cân",
      "system": "chuyen_hoa",
      "condition": {
        "logic": "or",
        "conditions": [
          {
            "metric": "bmi",
            "op": ">",
            "threshold": 25
          }
        ]
      },
      "severity": 0.5,
      "specialty": "Khoa Nội tiết",
      "evidence": "WHO TRS 894",
      "source_url": "https://iris.who.int/handle/10665/42330"
    }
  ],
  "system_labels": {
    "tim_manh": "Hệ tim mạch",
    "noi_tiet": "Hệ nội tiết",
    "than": "Chức năng thận",
    "ho_hap": "Hệ hô hấp",
    "chuyen_hoa": "Chuyển hóa"
  }
}
