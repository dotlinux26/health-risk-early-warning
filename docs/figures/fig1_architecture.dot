digraph "architecture" {
  rankdir=TB; bgcolor="white"; splines=polyline; nodesep=0.6; ranksep=0.7;

  node [fontname="Times New Roman", fontsize=13, shape=box, style="rounded,filled",
        fillcolor=white, color="#333333", penwidth=1.4, margin="0.25,0.16", width=1.6, height=0.9];
  edge [color="#333333", penwidth=1.4, arrowsize=0.9];

  input  [label="Chuỗi thời gian
chỉ số cơ thể"];
  t1     [label="Tầng 1
Thống kê cá nhân
Z-score · IF · EWMA"];
  t2     [label="Tầng 2
Tri thức y khoa
Rule engine (9 luật)"];
  t3     [label="Tầng 3
Fusion & Quyết định
Bayesian + isotonic"];
  ml     [label="LightGBM
(hiệu chỉnh isotonic)", shape=box, style="rounded,dashed,filled", fillcolor="#ececec"];
  out    [fillcolor="#f2f2f2", label="Kết quả: risk level
+ bằng chứng + khuyến nghị"];

  input -> t1;
  t1 -> t2;
  t2 -> t3;
  ml -> t3 [style=dashed, constraint=false];
  t3 -> out;
}